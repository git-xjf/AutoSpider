{
  "middlewares": [],
  "mcpServers": {
    "autospider": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["-m", "services.autospider_mcp.server"],
      "env": {
        "PYTHONPATH": ".",
        "AUTOSPIDER_ENGINE": "native",
        "AUTOSPIDER_DOMAIN_SCOPE": "site",
        "AUTOSPIDER_FAKE_IP_MODE": "verified_public",
        "AUTOSPIDER_RUNTIME_ROOT": "runtime/playwright"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 1800,
      "description": "Policy-constrained HTTP/JSON/Playwright inspection, execution, QA and site memory",
      "routing": {
        "mode": "off"
      },
      "tools": {
        "memory_lookup_site": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": ["crawl", "crawler", "scrape", "spider", "爬取", "采集", "抓取", "爬虫", "网页数据", "https://", "http://"]
          }
        },
        "crawl_reuse_workflow": {
          "routing": {
            "mode": "prefer",
            "priority": 90,
            "keywords": ["crawl", "crawler", "scrape", "spider", "爬取", "采集", "抓取", "爬虫", "网页数据", "https://", "http://"]
          }
        }
      }
    }
  },
  "skills": {
    "intelligent-crawling": {"enabled": true},
    "transport-selection": {"enabled": true},
    "webpage-analysis": {"enabled": true},
    "selector-engineering": {"enabled": true},
    "crawl-validation": {"enabled": true},
    "autospider-workflow": {"enabled": true}
  }
}
