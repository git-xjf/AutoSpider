# AutoSpider is developed and tested with: conda activate mytorch
AUTOSPIDER_ENGINE=native
AUTOSPIDER_RUNTIME_ROOT=runtime/playwright
AUTOSPIDER_ALLOW_CUSTOM_CODE=0

# Standalone defaults are strict. DeerFlow integration enables the following
# convenience profile for a trusted local Clash/TUN proxy.
AUTOSPIDER_DOMAIN_SCOPE=host
AUTOSPIDER_FAKE_IP_MODE=strict
# site: allow the start URL's registrable domain and its subdomains (offline PSL).
# verified_public: accept only DNS Fake-IP 198.18.0.0/15 after HTTPS public DNS
# verification; never exempts ordinary private IPs, localhost or Fake-IP literals.
# The DNS verification trusts the local proxy to dial the real public target.

# Optional legacy EasySpider backend during migration only.
EASYSPIDER_MODE=cli
EASYSPIDER_BASE_URL=http://127.0.0.1:8074
EASYSPIDER_HOME=D:\path\to\EasySpider\ElectronJS
EASYSPIDER_DATA_ROOT=D:\path\to\EasySpider\ElectronJS\Data
EASYSPIDER_EXECUTABLE=D:\path\to\EasySpider\easyspider_executestage.exe
EASYSPIDER_HTTP_TIMEOUT=30
AUTOSPIDER_MEMORY_DB=data/site_memory.db
AUTOSPIDER_MAX_PROBE_SESSIONS=4
AUTOSPIDER_PROBE_TIMEOUT_MS=30000
AUTOSPIDER_MCP_TRANSPORT=stdio

# DeerFlow model providers. Put real values only in .env / deer-flow\.env.
ZHIPUAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
